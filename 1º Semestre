print('Digite 0 para finalizar processo')

while True:
  acao = int(input('\nDisque a ação desejada: '))

  if acao == 1:
    nome = input('Digite o nome do contato: ').capitalize()
    numero = int(input('Digite seu telefone: '))
    telefones[nome] = numero
  elif acao == 2:
    busca = input('Digite o nome do contato para busca: ').capitalize()
    if busca in telefones:
      print(f'Numero do {busca}: {telefones[busca]}')
    else:
      print('Nome não cadastrado')
