#ENEM Timing

# Algo que precisei ano passado durante meus estudos, foi um controlador de tempo de prova para o ENEM

# Durante o ENEM, é necessário um controle de tempo por questão que você tem para fazer a prova, caso contrário, sobra muitas questões para pouco tempo no final da prova, gerando ansiedade, afobação, medo, etc.

# O programa "ENEM Timing" calcula o tempo médio por questão que o estudante utiliza para resolver questões do ENEM.

# O programa visa ajudar o estudante a simular se o seu tempo de prova está bom se comparado ao recomendado no ENEM.

# O ideal seria com as questões, pois já teriamos a dificuldade e poderiamos calcular o tempo no próprio site, mas como isso não é possível, tive que solicitar.

# (As questões e o tempo máximo foram dividias por 10 para ser mais rápida a simulação deste programa)

# Atribuições:

  # questões fáceis: max 1min e 30s
  # questões médias: max 2min
  # questões difíceis: max 3min

  # questão 1 a 3 = fácil
  # questão 4 a 6 = médio
  # questão 7 a 9 = difícil

print('** ENEM Timing **')
print('controle o seu tempo por questão para te auxiliar durante a prova')

nome = input('Digite o seu nome: ')

qual_dia = int(input(f'{nome}, digite 1 para começar a simulação: '))
i = 1
faceis = []
medias = []
dificeis = []
if qual_dia == 1:
# 3 questões faceis: 4min e 30 segundos
# 3 questões medias: 6 min
# 3 questões dificeis: 9 min
# Tempo total recomendado: 19,5 minutos
  print(f'\nDigite o tempo das questões em segundos, ex: 3 minutos = 180, ou, 1 minuto e meio = 90\n')
  print(f'')
  while i <= 3:
    print('_______________________________________________________________________________________________')
    tempo = int(input(f'Tempo da {i}ª questão (ex: 90): '))
    if tempo > 90:
      print(f'{nome}, você demorou demais para fazer essa questão. Como ela é fácil, você deve se agilizar para que não precise chutar questões mais a frente.')
      faceis.append(tempo)
      i +=1
    else:
      print(f'Você foi bem nessa!')
      faceis.append(tempo)
      i+=1
  while i <=6:
    print('________________________________________________________________________________________________')
    tempo = int(input(f'Tempo da {i}ª questão (ex: 120): '))
    if tempo > 120:
      print(f'{nome}, você demorou demais para fazer essa questão. Como ela é média, você deve se agilizar para que não precise chutar questões mais a frente.')
      medias.append(tempo)
      i +=1
    else:
      print(f'Você foi bem nessa!')
      medias.append(tempo)
      i+=1
  while i <= 9:
    print('________________________________________________________________________________________________')
    tempo = int(input(f'Tempo da {i}ª questão (ex: 180): '))
    if tempo > 180:
      print(f'{nome}, você demorou demais para fazer essa questão. Como ela é difícil, você pode optar por chutar ela, ou, não perder tanto tempo tentando resolvê-la.')
      dificeis.append(tempo)
      i +=1
    else:
      print(f'Você foi bem nessa!')
      dificeis.append(tempo)
      i+=1
# utilizei o append anteriormente para separar os tempos de cada dificuldade
# e agora utilizarei o extend para criar uma lista própria com todos os tempos
tempo_total = []
tempo_total.extend(faceis+medias+dificeis)
soma_total = 0
for i in tempo_total:
  soma_total += i
soma = soma_total // 60
# agora, somei todos os tempos totais e dividi por 60, conseguindo a soma do valor em minutos
# como o tempo recomendado da prova é de 19,5 minutos, fiz if e else para distinguir
if soma > 19.5:
  print(f'\nVocê deve se esforçar mais, pois seu tempo de prova não está dentro do recomendado.')
