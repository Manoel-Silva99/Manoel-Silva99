    qual = input('Digite o nome do contato que deseja alterar telefone: ').capitalize()
    if qual in telefones:
      numero_novo = int(input('Digite o novo numero do contato: '))
      telefones[qual] = numero_novo
      print(f'Novo número do {qual}: {telefones[qual]}')
    else:
      print('Nome não cadastrado')
  elif acao == 4:
    nome_remov = input('Digite o nome do contato para remover: ').capitalize()
    if nome_remov in telefones:
      del telefones[nome_remov]
      print('Contato removido com sucesso!')
    else:
      print('Nome não cadastrado')
  elif acao == 5:
    print(telefones)
  elif acao == 0:
    break
  else:
    print('Número incorreto')
